{
  "permissions": {
    "allow": [
      "Bash(factory-job *)",
      "Bash(factory-gate *)",
      "Bash(factory/checks.sh)",
      "Bash(./factory/checks.sh)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(git fetch *)",
      "Bash(git merge *)",
      "Bash(git merge-base *)",
      "Bash(git rev-parse *)",
      "Bash(.venv/bin/python -m ruff *)",
      "Bash(.venv/bin/python -m mypy *)",
      "Bash(.venv/bin/python -m unittest *)",
      "Bash(PYTHONPATH=src .venv/bin/python -m unittest *)",
      "Bash(python3 -m unittest *)",
      "Edit(/.claude/worktrees/**)",
      "Edit(/factory/jobs/**)"
    ],
    "deny": [
      "Bash(git push *)"
    ]
  },
  "extraKnownMarketplaces": {
    "ctdes-factory": {
      "source": { "source": "github", "repo": "CTDes/software-factory" }
    }
  },
  "enabledPlugins": {
    "software-factory@ctdes-factory": true
  }
}
